// Cloudflare Workers configuration (static assets only: no server code, so requests are free).
// Used by `npx wrangler deploy` and by Workers Builds when you connect this repo in the dashboard.
// Not needed if you deploy with Cloudflare Pages instead; see README.md.
{
  "name": "erfanpro",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
