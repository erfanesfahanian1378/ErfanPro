---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../data/site';
import { getProjects, type Project } from '../lib/content';

const projects = await getProjects();

const groups: { kind: Project['data']['kind']; title: string }[] = [
  { kind: 'personal', title: 'Personal & open source' },
  { kind: 'work', title: 'Work' },
  { kind: 'university', title: 'University' },
];

const sections = groups
  .map((group) => ({ ...group, items: projects.filter((project) => project.data.kind === group.kind) }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout title="Projects" description={`Projects by ${SITE.name}: personal products on GitHub, production systems, client work and university research.`}>
  <header class="page-header">
    <h1>Projects</h1>
    <p class="lead">
      Things I've built: my own products on GitHub, production systems at work and university research. For the full
      picture of each role, see my <a href="/cv/">CV</a>.
    </p>
  </header>

  {
    sections.map((group) => (
      <section class="section" aria-labelledby={`group-${group.kind}`}>
        <SectionHeading id={`group-${group.kind}`} title={group.title} />
        <div class="card-stack">
          {group.items.map((project) => (
            <ProjectCard project={project} full />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
