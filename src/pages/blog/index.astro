---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostList from '../../components/PostList.astro';
import { SITE } from '../../data/site';
import { getPosts, type Post } from '../../lib/content';

const posts = await getPosts();

// Group posts by year, newest year first (posts are already sorted newest first).
const years = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}
---

<BaseLayout title="Blog" description={`Posts by ${SITE.name} on back-end engineering, integrations, automation and side projects.`}>
  <header class="page-header">
    <h1>Blog</h1>
    <p class="lead">
      Notes on back-end engineering, integrations and automation, plus the occasional game or AI experiment from
      university.
    </p>
    <a class="subtle-link" href="/rss.xml" data-astro-reload>
      <Icon name="rss" size={16} />
      Subscribe via RSS
    </a>
  </header>

  {posts.length === 0 && <p class="empty-state">No posts yet.</p>}

  {
    [...years].map(([year, list]) => (
      <section class="year-group" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="year-heading">
          {year}
        </h2>
        <PostList posts={list} descriptions />
      </section>
    ))
  }
</BaseLayout>
