---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, getPosts, postUrl, readingTime, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} type="article" publishedTime={date} modifiedTime={updated}>
  <article class="post">
    <a class="back-link" href="/blog/">
      <Icon name="arrowLeft" size={16} />
      All posts
    </a>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{readingTime(post.body)}</span>
        {
          updated && (
            <span>
              Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </span>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  {
    (older || newer) && (
      <nav class="post-nav" aria-label="More posts">
        {older && (
          <a class="post-nav-link" href={postUrl(older)}>
            <span>Older</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a class="post-nav-link newer" href={postUrl(newer)}>
            <span>Newer</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>
