---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { SITE, SOCIALS } from '../../data/site';
import { EDUCATION, EXPERIENCE, LANGUAGES, OTHER_EXPERIENCE, PROFILE, SKILLS } from '../../data/cv';
import { localeStaticPaths, localizePath, pick, type Locale } from '../../i18n/config';
import { dateRange, digits } from '../../i18n/format';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale);

// "github.com/erfanesfahanian1378" instead of the full URL, so the printed CV stays readable.
const display = (href: string) => href.replace(/^mailto:/, '').replace(/^https?:\/\/(www\.)?/, '');
const website = Astro.site ? display(new URL(localizePath('/', locale), Astro.site).href).replace(/\/$/, '') : '';

const comma = locale === 'fa' ? '، ' : ', ';

const roleSections = [
  { id: 'cv-experience', title: t.sections.experience, roles: EXPERIENCE },
  { id: 'cv-other', title: t.sections.otherExperience, roles: OTHER_EXPERIENCE },
].filter((section) => section.roles.length > 0);
---

<BaseLayout locale={locale} title={t.cv.title} description={t.cv.description} mainClass="cv-page">
  <header class="cv-header">
    {SITE.avatar && <img class="cv-photo" src={SITE.avatar} alt={t.photoAlt} width="104" height="104" />}
    <div>
      <h1>{t.name}</h1>
      <p class="cv-headline">{t.headline}</p>
      <ul class="cv-contact">
        <li><Icon name="mapPin" size={16} />{t.location}</li>
        {
          SOCIALS.map((link) => (
            <li>
              <a href={link.href}>
                <Icon name={link.icon} size={16} />
                <span dir="ltr">{display(link.href)}</span>
              </a>
            </li>
          ))
        }
        {
          website && (
            <li class="print-only">
              <span dir="ltr">{website}</span>
            </li>
          )
        }
      </ul>
    </div>
    <button type="button" class="button print-button" onclick="window.print()">
      <Icon name="printer" size={18} />
      {t.cv.savePdf}
    </button>
  </header>

  <section class="cv-section" aria-labelledby="cv-profile">
    <h2 id="cv-profile">{t.sections.profile}</h2>
    {PROFILE.map((paragraph) => <p>{paragraph[locale]}</p>)}
  </section>

  {
    roleSections.map((section) => (
      <section class="cv-section" aria-labelledby={section.id}>
        <h2 id={section.id}>{section.title}</h2>
        {section.roles.map((role) => (
          <article class="cv-entry">
            <div class="cv-entry-head">
              <h3>
                {role.title[locale]} <span class="org">· {pick(role.org, locale)}</span>
              </h3>
              <p class="cv-dates">{dateRange(role.start, role.end, locale)}</p>
            </div>
            <p class="cv-meta">
              {[role.note?.[locale], role.location[locale], role.mode?.[locale]].filter(Boolean).join(' · ')}
            </p>
            <ul>
              {role.highlights.map((item) => (
                <li>{item[locale]}</li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    ))
  }

  <section class="cv-section" aria-labelledby="cv-education">
    <h2 id="cv-education">{t.sections.education}</h2>
    {
      EDUCATION.map((degree) => (
        <article class="cv-entry">
          <div class="cv-entry-head">
            <h3>
              {degree.degree[locale]}
              {degree.detail && <span class="org"> ({degree.detail[locale]})</span>}
            </h3>
            <p class="cv-dates">{digits(degree.period, locale)}</p>
          </div>
          <p class="cv-meta">{[degree.school[locale], degree.location[locale]].join(comma)}</p>
          {degree.notes.length > 0 && <p>{degree.notes.map((note) => note[locale]).join(' · ')}</p>}
        </article>
      ))
    }
  </section>

  <section class="cv-section" aria-labelledby="cv-skills">
    <h2 id="cv-skills">{t.sections.technicalSkills}</h2>
    <dl class="cv-skills">
      {
        SKILLS.map(({ group, items }) => (
          <div>
            <dt>{group[locale]}</dt>
            <dd>
              {/* One line on purpose: whitespace here would show up before each comma. */}
              {items.map((item, index) => <>{index > 0 && comma}<bdi>{pick(item, locale)}</bdi></>)}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="cv-section" aria-labelledby="cv-languages">
    <h2 id="cv-languages">{t.sections.languages}</h2>
    <ul class="cv-languages">
      {
        LANGUAGES.map((language) => (
          <li>
            <strong>{language.name[locale]}</strong> <span>· {language.level[locale]}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
