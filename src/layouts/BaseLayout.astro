---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALE_META } from '../i18n/config';
import { ui } from '../i18n/ui';
import '../styles/global.css';

type Props = HeadProps & {
  /** Extra class on <main>, e.g. to change the page width. */
  mainClass?: string;
  /** Page the language menu links to, without the language prefix. Defaults to this page. */
  translationPath?: string;
};

const { mainClass, translationPath, ...head } = Astro.props;
const { locale } = head;
---

<!doctype html>
<html lang={locale} dir={LOCALE_META[locale].dir}>
  <head>
    <BaseHead {...head} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui(locale).skipToContent}</a>
    <Header locale={locale} translationPath={translationPath} />
    <main id="main" class:list={['container', mainClass]}>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
