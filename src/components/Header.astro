---
import Icon from './Icon.astro';
import { NAV, SITE } from '../data/site';
import { LOCALES, LOCALE_META, localizePath, stripLocale, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Page the language menu links to, without the language prefix. Defaults to the current page. */
  translationPath?: string;
}

const { locale, translationPath } = Astro.props;
const t = ui(locale);
const basePath = stripLocale(Astro.url.pathname);
const isActive = (href: string) => basePath === href || basePath.startsWith(href);
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <div class="container header-inner">
    <a href={localizePath('/', locale)} class="brand" aria-label={`${t.name}, ${t.home}`}>
      {
        SITE.avatar ? (
          <img class="brand-photo" src={SITE.avatar} alt="" width="32" height="32" />
        ) : (
          <span class="brand-mark" aria-hidden="true">
            {SITE.initials}
          </span>
        )
      }
      <span class="brand-name">{t.name}</span>
    </a>
    <nav aria-label={t.mainMenu}>
      <ul class="nav-list">
        {
          NAV.map(({ key, href }) => (
            <li>
              <a href={localizePath(href, locale)} aria-current={isActive(href) ? 'page' : undefined}>
                {t.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <details class="lang-menu">
      <summary aria-label={t.language}>
        <Icon name="world" size={18} />
        <span>{LOCALE_META[locale].short}</span>
      </summary>
      <ul class="lang-list">
        {
          LOCALES.map((l) => (
            <li>
              <a
                href={localizePath(translationPath ?? basePath, l)}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? 'true' : undefined}
              >
                {LOCALE_META[l].label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label={t.darkMode} aria-pressed="false">
      <Icon name="moon" class="icon-moon" />
      <Icon name="sun" class="icon-sun" />
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const sync = () =>
    document.getElementById('theme-toggle')?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));

  // The header is replaced on every page switch, so listen on the document rather than the button.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;

    // Close the language menu when clicking anywhere else.
    document.querySelectorAll<HTMLDetailsElement>('.lang-menu[open]').forEach((menu) => {
      if (!target || !menu.contains(target)) menu.open = false;
    });

    if (!target?.closest('#theme-toggle')) return;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be unavailable (private mode); the theme still switches for this page.
    }
    sync();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.lang-menu[open]').forEach((menu) => {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  });

  // Follow the operating system's setting until the visitor picks a theme themselves.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let saved = null;
    try {
      saved = localStorage.getItem('theme');
    } catch {
      // Ignore: treat as "no saved preference".
    }
    if (saved) return;
    root.dataset.theme = event.matches ? 'dark' : 'light';
    sync();
  });

  document.addEventListener('astro:page-load', sync);
  sync();
</script>
