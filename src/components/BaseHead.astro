---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../data/site';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, localizePath, stripLocale, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

export interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Social preview image, relative to the site root. */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** Path of the preferred version of this page, when it isn't the page itself. */
  canonicalPath?: string;
}

const {
  locale,
  title,
  description,
  image = '/og.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  canonicalPath,
} = Astro.props;

const t = ui(locale);
const pageTitle = title ? `${title} · ${t.name}` : t.siteTitle;
const pageDescription = description ?? t.siteDescription;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const basePath = stripLocale(Astro.url.pathname);
const alternates = LOCALES.map((l) => ({ lang: l, href: new URL(localizePath(basePath, l), Astro.site).href }));
const ogImage = new URL(image, Astro.site);
const feed = new URL('rss.xml', Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="author" content={SITE.name} />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
{
  !noindex &&
    alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)
}
{!noindex && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === DEFAULT_LOCALE)?.href} />}

<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c0d0f" media="(prefers-color-scheme: dark)" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} · Blog`} href={feed} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${t.name}, ${t.headline}`} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{
  LOCALES.filter((l) => l !== locale).map((l) => (
    <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
  ))
}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />

<!-- Switch pages in place (no full reload), with a short fade. Also prefetches links on hover. -->
<ClientRouter />

<script is:inline>
  // Apply the saved (or system) colour theme before the page paints, to avoid a flash.
  (function () {
    function preferredTheme() {
      var saved = null;
      try {
        saved = localStorage.getItem('theme');
      } catch (e) {}
      if (saved === 'dark' || saved === 'light') return saved;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    var root = document.documentElement;
    root.classList.add('js');
    root.dataset.theme = preferredTheme();

    // Page switches replace the <html> attributes with the incoming page's, so carry the
    // current theme over to each new page before it is shown.
    if (!window.__themeCarriedOver) {
      window.__themeCarriedOver = true;
      document.addEventListener('astro:before-swap', function (event) {
        var next = event.newDocument.documentElement;
        next.classList.add('js');
        next.dataset.theme = document.documentElement.dataset.theme || preferredTheme();
      });
    }
  })();
</script>
