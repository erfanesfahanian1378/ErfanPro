---
import Icon from './Icon.astro';
import { SOCIALS } from '../data/site';
import type { Locale } from '../i18n/config';
import { digits } from '../i18n/format';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale);
const year = digits(String(new Date().getFullYear()), locale);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} {t.name}</p>
    <ul class="footer-links" aria-label={t.footer.elsewhere}>
      {
        SOCIALS.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.icon === 'mail' ? undefined : 'me noopener'}
              target={link.icon === 'mail' ? undefined : '_blank'}
            >
              <Icon name={link.icon} size={18} label={link.icon === 'mail' ? t.email : link.label} />
            </a>
          </li>
        ))
      }
      <li>
        <a href="/rss.xml" data-astro-reload><Icon name="rss" size={18} label={t.footer.rss} /></a>
      </li>
    </ul>
  </div>
</footer>
