---
import Icon from './Icon.astro';
import { SITE, SOCIALS } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} {SITE.name}</p>
    <ul class="footer-links" aria-label="Elsewhere">
      {
        SOCIALS.map((link) => (
          <li>
            <a href={link.href} rel={link.icon === 'mail' ? undefined : 'me noopener'} target={link.icon === 'mail' ? undefined : '_blank'}>
              <Icon name={link.icon} size={18} label={link.label} />
            </a>
          </li>
        ))
      }
      <li>
        <a href="/rss.xml"><Icon name="rss" size={18} label="RSS feed" /></a>
      </li>
    </ul>
  </div>
</footer>
