---
import Icon from './Icon.astro';

interface Props {
  title: string;
  id?: string;
  more?: { href: string; label: string };
}

const { title, id, more } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}>{title}</h2>
  {
    more && (
      <a class="more-link" href={more.href}>
        {more.label}
        <Icon name="arrowRight" size={16} />
      </a>
    )
  }
</div>
